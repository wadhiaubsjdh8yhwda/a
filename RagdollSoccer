function MystrixHub.Functions.InstallSilentAim()
    local F = MystrixHub.Functions
    local SA = getgenv().MystrixSilentAim
    SA.Redirect = F.SilentAimRedirect
    F.SilentAimModules()
    if not SA.Hooked then
        local ok, DribbleClient = pcall(function()
            return require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Client"):WaitForChild("Game"):WaitForChild("DribbleClient"))
        end)
        if ok and type(DribbleClient) == "table" then
            local installed = 0
            for _, name in ipairs({ "strike", "strikeFree" }) do
                local fn = DribbleClient[name]
                if type(fn) == "function" then
                    local orig
                    local function wrapper(from, vel, spin, family, t)
                        if SA.Enabled and SA.Redirect and typeof(from) == "Vector3" and typeof(vel) == "Vector3" then
                            local rok, newVel, newSpin = pcall(SA.Redirect, from, vel, spin, family)
                            if rok and newVel then
                                SA.LastVel = newVel
                                SA.LastAt = os.clock()
                                vel = newVel
                                spin = newSpin or spin
                                MystrixHub.ShotLast = nil
                            end
                        end
                        return orig(from, vel, spin, family, t)
                    end
                    if hookfunction then
                        local hok, result = pcall(hookfunction, fn, wrapper)
                        if hok and result then
                            orig = result
                            installed += 1
                        end
                    else
                        orig = fn
                        if pcall(function() DribbleClient[name] = wrapper end) then
                            installed += 1
                        end
                    end
                end
            end
            SA.Hooked = installed > 0
        end
    end
    if not SA.RemoteHooked and not SA.Hooked and hookmetamethod and getnamecallmethod then
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if not SA.Enabled then return old(self, ...) end
            if getnamecallmethod() == "FireServer" then
                local plan = ...
                if type(plan) == "table" and plan.hold ~= true and typeof(plan.ball) == "Vector3" and typeof(plan.vel) == "Vector3" and type(plan.family) == "string" and plan.power ~= nil then
                    local last = SA.LastVel
                    local fresh = last and os.clock() - (SA.LastAt or 0) < 0.4 and (plan.vel - last).Magnitude < 0.05
                    if not fresh and SA.Redirect then
                        local rok, newVel, newSpin = pcall(SA.Redirect, plan.ball, plan.vel, plan.spin, plan.family)
                        if rok and newVel then
                            local args = { ... }
                            local copy = table.clone(plan)
                            copy.vel = newVel
                            copy.spin = newSpin or copy.spin
                            MystrixHub.ShotLast = nil
                            args[1] = copy
                            if setnamecallmethod then setnamecallmethod("FireServer") end
                            return old(self, table.unpack(args))
                        end
                        if setnamecallmethod then setnamecallmethod("FireServer") end
                    end
                end
            end
            return old(self, ...)
        end))
        SA.RemoteHooked = true
    end
    F.StartShotTick()
    return SA.Hooked or SA.RemoteHooked == true
end


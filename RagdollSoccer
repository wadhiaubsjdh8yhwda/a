        end)
        SA.Radius = (ok and type(r) == "number") and math.clamp(r, 0.5, 2) or 1.1
    end
    local env = MystrixHub.ShotEnvCache
    local now = os.clock()
    if not env or env.Ball ~= ball or now - env.At > 0.5 then
        env = { Ball = ball, Params = SA.Flight.params(ball), At = now }
        MystrixHub.ShotEnvCache = env
    end
    env.Goal = goal
    env.Radius = SA.Radius
    return env
end

function MystrixHub.Functions.ShotBodies(goal, lob)
    local bx, bz, n = {}, {}, 0
    if lob then return bx, bz, 0 end
    for _, entry in ipairs(MystrixHub.Functions.MannequinSnapshot()) do
        if entry.model ~= goal.char and not entry.keeper then
            n += 1
            bx[n] = entry.pos.X
            bz[n] = entry.pos.Z
        end
    end
    return bx, bz, n
end

function MystrixHub.Functions.ShotPoint(goal, mode)
    local height = goal.top - goal.ground
    local inset = goal.half - 2.8
    local top = goal.top - 1.5
    local bottom = goal.ground + 1.4
    local right = goal.z + goal.out * inset
    local left = goal.z - goal.out * inset
    if mode == "Top Right Corner" then return Vector3.new(goal.x, top, right) end
    if mode == "Bottom Right Corner" then return Vector3.new(goal.x, bottom, right) end
    if mode == "Top Left Corner" then return Vector3.new(goal.x, top, left) end
    if mode == "Bottom Left Corner" then return Vector3.new(goal.x, bottom, left) end
    if mode == "Middle" then return Vector3.new(goal.x, goal.ground + height * 0.4, goal.z) end
    return nil
end

function MystrixHub.Functions.ShotAutoList(goal, lob, keeper)
    local height = goal.top - goal.ground
    local ys = lob and { 0.55, 0.68, 0.78 } or { 0.2, 0.32, 0.44, 0.58, 0.7, 0.78 }
    local zs = { -0.72, -0.56, -0.4, -0.24, -0.08, 0.08, 0.24, 0.4, 0.56, 0.72 }
    local rand = math.random
    local list, n = {}, 0
    for _, zf in ipairs(zs) do
        for _, yf in ipairs(ys) do
            local jz = math.clamp(zf + (rand() - 0.5) * 0.1, -0.75, 0.75)
            local jy = math.clamp(yf + (rand() - 0.5) * 0.06, 0.18, 0.8)
            local p = Vector3.new(goal.x, goal.ground + height * jy, goal.z + goal.half * jz)
            local score
            if keeper then
                local dz = p.Z - keeper.Z
                local dy = (p.Y - (goal.ground + 3.5)) * 0.6
                score = math.sqrt(dz * dz + dy * dy)
            else
                score = rand() * 10
            end
            n += 1
            list[n] = { point = p, score = score }
        end
    end
    table.sort(list, function(a, b) return a.score > b.score end)
    local pool = math.min(n, 16)
    for i = pool, 2, -1 do
        local j = rand(1, i)
        list[i], list[j] = list[j], list[i]
    end
    return list
end

function MystrixHub.Functions.ShotFly(env, gy, from, vel, spin, limitT, bx, bz, bn, stepDt)
    local Flight = SilentAimState.Flight
    local params = env.Params
    local goal = env.Goal
    local gx, out = goal.x, goal.out
    local airStep, rollStep = Flight.airStep, Flight.rollStep
    local bounce, toGround, bounceMin = Flight.bounce, Flight.toGround, Flight.BOUNCE_MIN
    local pos, v, s = from, vel, spin
    local rolling = false
    if pos.Y <= gy + 0.05 and v.Y <= bounceMin then
        rolling = true
        pos = Vector3.new(pos.X, gy, pos.Z)
        v, s = toGround(v, s)
    end
    local dt = stepDt or 1 / 60
    local t = 0
    local blocked = false
    local fx, fz = from.X, from.Z
    local step = 0
    while t < limitT do
        local np, nv, ns
        if rolling then
            np, nv, ns = rollStep(pos, v, s, dt, params)
            if nv.X * nv.X + nv.Z * nv.Z < 0.04 then
                return nil, t, blocked
            end
        else
            np, nv, ns = airStep(pos, v, s, dt, params)
            if np.Y < gy and nv.Y < 0 then
                local k = math.clamp((pos.Y - gy) / math.max(pos.Y - np.Y, 1e-6), 0, 1)
                local hp, hv, hs = airStep(pos, v, s, dt * k, params)
                hp = Vector3.new(hp.X, gy, hp.Z)
                local bv, bs = bounce(hv, hs, params)
                if bv.Y < bounceMin then
                    bv, bs = toGround(bv, bs)
                    rolling = true
                    np, nv, ns = rollStep(hp, bv, bs, dt * (1 - k), params)
                else
                    np, nv, ns = airStep(hp, bv, bs, dt * (1 - k), params)
                end
            end
        end
        if (np.X - gx) * out >= 0 then
            local dx = np.X - pos.X
            local a = dx ~= 0 and math.clamp((gx - pos.X) / dx, 0, 1) or 1
            return pos:Lerp(np, a), t + dt * a, blocked
        end
        if bn > 0 and not blocked and np.Y - gy < 7 then
            step += 1
            if step % 2 == 0 then
                local ox, oz = np.X - fx, np.Z - fz
                if ox * ox + oz * oz > 16 then
                    for i = 1, bn do
                        local ex, ez = bx[i] - np.X, bz[i] - np.Z
                        if ex * ex + ez * ez < 5.8 then
                            blocked = true
                            break
                        end
                    end
                end
            end
        end
        pos, v, s = np, nv, ns
        t += dt
    end
    return nil, t, blocked
end

function MystrixHub.Functions.ShotSolve(env, gy, from, point, speed, curve, minA, maxA, key, bx, bz, bn, lob, fine, iters)
    local F = MystrixHub.Functions
    local flat = Vector3.new(point.X - from.X, 0, point.Z - from.Z)
    local d = flat.Magnitude
    if d < 2 then return nil end
    local dir = flat / d
    local up = Vector3.new(0, 1, 0)
    local side = dir:Cross(up)
    local seeds = MystrixHub.ShotSeeds
    local seed = seeds[key]
    if seed and ((seed[3] - from).Magnitude > 6 or math.abs(seed[4] - speed) > 2) then
        seed = nil
    end
    local angle, ry
    if seed then
        angle, ry = seed[1], seed[2]
    else
        local q = d / speed
        angle = math.atan2(point.Y - from.Y + env.Params.gravity * 0.5 * q * q, math.max(d, 1))
        ry = 0
        if curve ~= 0 then
            local coef = math.min(0.5164 * math.abs(curve) / speed, 0.3) * 0.0541 * 0.213 * speed * speed * (env.Params.curve or 1)
            local tf = d / (speed * 0.75)
            ry = -(curve > 0 and 1 or -1) * math.clamp(0.45 * coef * tf * tf / d, 0, 0.35)
        end
    end
    local spin = Vector3.new(0, curve, 0)
    local limitT = math.clamp(d / math.max(speed * 0.45, 6) + 0.8, 1, lob and 8 or 4.5)
    local stepDt = lob and 1 / 30 or (fine and (type(fine) == "number" and 1 / fine or 1 / 60) or 1 / 45)
    local maxIter = iters or (seed and 5 or (curve ~= 0 and 8 or 7))
    local minIter = curve ~= 0 and (MystrixHub.ShotMinIter or 3) or 2
    local deadline = MystrixHub.ShotDeadline or math.huge
    local best, bestMiss = nil, math.huge
    local pAngle, pY, pRy, pEl
    local baseA, baseR = d * 1.1, d
    for i = 1, maxIter do
        if i > minIter and best and os.clock() > deadline then break end
        angle = math.clamp(angle, minA, maxA)
        local fd = CFrame.Angles(0, ry, 0) * dir
        local vel = (fd * math.cos(angle) + up * math.sin(angle)) * speed
        local c, ft, blocked = F.ShotFly(env, gy, from, vel, spin, limitT, bx, bz, bn, stepDt)
        if not c then
            angle += 0.1
            pAngle = nil
        else
            local delta = point - c
            local el = delta:Dot(side)
            local miss = math.sqrt(delta.Y * delta.Y + el * el)
            if miss < bestMiss then
                bestMiss = miss
                best = { vel, miss, ft, blocked, c, angle, ry }
            end
            if miss < 0.3 then break end
            local sa, sr = baseA, baseR
            if pAngle and math.abs(angle - pAngle) > 1e-4 then
                local s = (c.Y - pY) / (angle - pAngle)
                if s > 0.25 * d and s < 4 * d then sa = s end
            end
            if pRy and math.abs(ry - pRy) > 1e-4 then
                local s = (el - pEl) / (ry - pRy)
                if s > 0.25 * d and s < 4 * d then sr = s end
            end
            pAngle, pY, pRy, pEl = angle, c.Y, ry, el
            angle += math.clamp(delta.Y / sa, -0.3, 0.3)
            ry += math.clamp(-el / sr, -0.3, 0.3)
        end
    end
    if not best then return nil end
    seeds[key] = { best[6], best[7], from, speed }
    return best[1], spin, best[2], best[3], best[4], best[5]
end

function MystrixHub.Functions.ShotBest(from, family, lob, budget, minAngle)
    local F = MystrixHub.Functions
    local SA = SilentAimState
    local env = F.ShotEnv()
    if not env then return nil end
    local goal = env.Goal
    local params = env.Params
    local gy = SA.BallView.groundBallY(from)
    local fam = SA.Families[family]
    local cap = 125
    if fam and fam.speed then
        local top = math.max(fam.speed[2], fam.shotSpeed and fam.shotSpeed[2] or 0)
        cap = top * (fam.header and 1 or 1.05) * 0.97
    end
    local flatD = Vector3.new(goal.x - from.X, 0, goal.z - from.Z).Magnitude
    local speed = cap
    if lob then
        speed = math.clamp(math.sqrt(params.gravity * math.max(flatD, 12) / 0.9) * 1.12, 20, cap)
    end
    local minA = minAngle or (lob and 0.35 or -0.9)
    local maxA = lob and 1.3 or 0.8
    local keeper = F.SilentAimKeeper(goal)
    local bx, bz, bn = F.ShotBodies(goal, lob)
    local curveOn = SA.AutoCurve == true and not lob and flatD >= 12 and not (fam and fam.header)
    local k = math.clamp(34 + flatD * 0.4, 40, 68)
    local noCurve = { 0 }
    local clear = env.Radius + 0.1
    local zLim = goal.half - clear
    local yMin = goal.ground + 0.3
    local yMax = goal.top - clear
    local spent = budget or 0.008
    local deadline = os.clock() + spent
    MystrixHub.ShotDeadline = deadline
    MystrixHub.ShotMinIter = spent >= 0.004 and 5 or 3
    local best, fallback, loose
    local bestScore, fallbackScore, looseScore = -math.huge, -math.huge, -math.huge
    local count = 0
    local done = false

    local function run(list)
        for _, cand in ipairs(list) do
            local p = cand.point
            local curves = noCurve
            if curveOn then
                local s = ((goal.z - p.Z) >= 0 and -1 or 1) * goal.out
                curves = { k * s, -k * s, 0 }
            end
            for _, curve in ipairs(curves) do
                if done then return end
                if count > 0 and (os.clock() > deadline or (best and count >= 4)) then return end
                count += 1
                local sign = curve > 0 and 1 or curve < 0 and -1 or 0
                local key = ((math.floor(p.Z * 2) + 2000) * 4096 + (math.floor(p.Y * 2) + 2000)) * 8 + (sign + 1) * 2 + (lob and 1 or 0)
                local vel, spin, miss, ft, blocked, c = F.ShotSolve(env, gy, from, p, speed, curve, minA, maxA, key, bx, bz, bn, lob)
                if vel then
                    local dz = math.abs(c.Z - goal.z)
                    if dz <= goal.half - 0.8 and c.Y >= goal.ground + 0.3 and c.Y <= goal.top - 0.4 then
                        local kd
                        if keeper then
                            local kz = c.Z - keeper.Z
                            local ky = (c.Y - (goal.ground + 3.5)) * 0.6
                            kd = math.sqrt(kz * kz + ky * ky)
                        else
                            kd = dz * 0.8
                        end
                        local strict = dz <= zLim and c.Y >= yMin and c.Y <= yMax and miss <= 0.9
                        local entry = {
                            vel = vel,
                            spin = spin,
                            point = p,
                            curve = curve,
                            miss = miss,
                            time = ft,
                            blocked = blocked,
                            cross = c,
                            key = key,
                            kd = kd,
                        }
                        if strict then
                            local edge = math.min(zLim - dz, yMax - c.Y)
                            local score = kd - miss * 4 - ft * (lob and 0.4 or 2.5) + math.min(edge, 2) * 1.5
                            if curve ~= 0 then score += 6 end
                            entry.score = score
                            if blocked then
                                if score - 12 > fallbackScore then
                                    fallbackScore = score - 12
                                    entry.fallback = true
                                    fallback = entry
                                end
                            elseif score > bestScore then
                                bestScore = score
                                best = entry
                                if miss < 0.5 and edge >= 1 and kd >= (curve ~= 0 and 2 or 4) then done = true end
                            end
                        elseif miss <= 3.5 and -miss > looseScore then
                            looseScore = -miss
                            entry.score = -miss
                            entry.fallback = true
                            loose = entry
                        end
                    end
                end
            end
        end
    end

    local mode = SA.Target
    local pinned = (mode and mode ~= "Auto") and F.ShotPoint(goal, mode) or nil
    if pinned then run({ { point = pinned } }) end
    local prev = MystrixHub.ShotLast
    if not best and not pinned then
        if prev and prev.lob == lob and prev.goalX == goal.x and os.clock() - (prev.at or 0) < 1.5 and os.clock() - (prev.born or 0) < 3 then
            run({ { point = prev.point } })
        end
    end
    if not best then run(F.ShotAutoList(goal, lob, keeper)) end
    local result = best or fallback or loose

    if result and not lob and spent >= 0.004 and (result.curve ~= 0 or F.Budget(1) == 1) then
        local curved = result.curve ~= 0
        local vel, spin, miss, ft, blocked, c = F.ShotSolve(env, gy, from, result.point, speed, result.curve, minA, maxA, result.key, bx, bz, bn, lob, curved and 90 or true, curved and 3 or 2)
        if vel and c then
            local dz = math.abs(c.Z - goal.z)
            local better = miss <= result.miss + 0.15 or (curved and miss <= 1.2)
            if better and dz <= goal.half - 0.8 and c.Y >= goal.ground + 0.3 and c.Y <= goal.top - 0.4 and (result.blocked or not blocked) then
                result.vel = vel
                result.spin = spin
                result.miss = miss
                result.time = ft
                result.blocked = blocked
                result.cross = c
            end
        end
    end

    if result then
        result.from = from
        result.lob = lob
        result.goalX = goal.x
        result.at = os.clock()
        if prev and prev.born and result.point == prev.point and os.clock() - prev.born < 3 then
            result.born = prev.born
        else
            result.born = os.clock()
        end
        MystrixHub.ShotLast = result
    end
    return result
end

function MystrixHub.Functions.PreviewAim(from, vel, spin)
    local F = MystrixHub.Functions
    local SA = getgenv().MystrixSilentAim
    if not F.SilentAimModules() then return nil end
    local goal = F.SilentAimGoal()
    if not goal then return nil end
    local toGoal = Vector3.new(goal.x - from.X, 0, goal.z - from.Z)
    local dist = toGoal.Magnitude
    if dist > 190 or dist < 2 then return nil end
    if (from.X - goal.x) * goal.out >= 0 then return nil end
    local flat = Vector3.new(vel.X, 0, vel.Z)
    local fm = flat.Magnitude
    if fm > 1 and flat.Unit:Dot(toGoal.Unit) < -0.2 then return nil end
    local family, lob, minAngle = "Laced", false, nil
    local auto = MystrixHub.Auto
    if auto and auto.Phase == "air" then
        local gy = SA.BallView.groundBallY(from)
        family = auto.Mode == "away" and "Bicycle" or (from.Y - gy <= 2.4 and "Volley" or "RunningHeader")
        minAngle = -0.95
    elseif MystrixHub.TrickActive then
        if MystrixHub.TrickKey == "KickLob" then
            family, lob = "Lofted", true
        end
    elseif fm > 1 and vel.Y / fm > 0.62 then
        family, lob = "Lofted", true
    end
    local now = os.clock()
    local c = MystrixHub.PreviewCache
    if c and c.family == family and c.goalX == goal.x and now - c.at < 0.15 and (c.from - from).Magnitude < 0.8 then
        return c.vel, c.spin
    end
    local result = F.ShotBest(from, family, lob, F.Budget(0.002), minAngle)
    if not result then return nil end
    MystrixHub.PreviewCache = { at = now, from = from, family = family, goalX = goal.x, vel = result.vel, spin = result.spin }
    return result.vel, result.spin
end

function MystrixHub.Functions.InstallPreviewSpoof()
    local SA = getgenv().MystrixSilentAim

    if not SA.PreviewShowHooked and not SA.PreviewShowHooking then
        SA.PreviewShowHooking = true
        task.spawn(function()
            local ok, KP = pcall(function()
                local game_ = LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Client"):WaitForChild("Game")
                return require(game_:WaitForChild("KickPreview", 10))
            end)
            if not (ok and type(KP) == "table" and type(KP.show) == "function") then
                SA.PreviewShowHooking = false
                return
            end
            local orig = KP.show
            local function wrapper(strike, ...)
                local state = getgenv().MystrixSilentAim
                if state.Enabled and state.Spoof ~= false and type(strike) == "table" and typeof(strike.from) == "Vector3" and typeof(strike.vel) == "Vector3" then
                    local view = MystrixHub.TrickView
                    local locked = view ~= nil and view.Active == true
                    local rok, nv, ns = pcall(MystrixHub.Functions.PreviewAim, strike.from, strike.vel, strike.spin)
                    if rok and nv then
                        local copy = table.clone(strike)
                        copy.vel = nv
                        copy.spin = ns or strike.spin
                        if locked then copy.turn = false end
                        state.PreviewLastVel = nv
                        return orig(copy, ...)
                    end
                    if locked then
                        local copy = table.clone(strike)
                        copy.turn = false
                        return orig(copy, ...)
                    end
                end
                return orig(strike, ...)
            end
            KP.show = wrapper
            SA.PreviewShowHooked = true
            SA.PreviewShowHooking = false
            MystrixHub.ConnectionController.Insert({ Disconnect = function()
                if KP.show == wrapper then
                    KP.show = orig
                end
                SA.PreviewShowHooked = false
            end })
        end)
    end

    if SA.PreviewHooked or SA.PreviewHooking then return end
    if not (hookmetamethod and getnamecallmethod and newcclosure) then return end
    SA.PreviewHooking = true
    task.spawn(function()
        local ok, remote = pcall(function()
            local Net = require(Services.ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
            return Net:UnreliableRemoteEvent("KickPreview")
        end)
        if not (ok and typeof(remote) == "Instance") then
            SA.PreviewHooking = false
            return
        end
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if self ~= remote then return old(self, ...) end
            local state = getgenv().MystrixSilentAim
            if not state.Enabled or state.Spoof == false then return old(self, ...) end
            if getnamecallmethod() ~= "FireServer" then return old(self, ...) end
            local from, vel, spin = ...
            if typeof(from) == "Vector3" and typeof(vel) == "Vector3" then
                local last = state.PreviewLastVel
                if last and (vel - last).Magnitude < 0.01 then
                    return old(self, ...)
                end
                local count = select("#", ...)
                local rok, nv, ns = pcall(MystrixHub.Functions.PreviewAim, from, vel, spin)
                if setnamecallmethod then setnamecallmethod("FireServer") end
                if rok and nv then
                    local args = { ... }
                    args[2] = nv
                    args[3] = ns or spin
                    return old(self, table.unpack(args, 1, count))
                end
            end
            return old(self, ...)
        end))
        SA.PreviewHooked = true
    end)
end

function MystrixHub.Functions.ShotPredict(params, pos, vel, spin, gy, horizon, dt)
    local Flight = getgenv().MystrixSilentAim.Flight
    local list = {}
    local v, s = vel, spin
    local rolling = false
    local t = 0
    local n = 0
    while t < horizon do
        local np, nv, ns
        if rolling then
            np, nv, ns = Flight.rollStep(pos, v, s, dt, params)
        else
            np, nv, ns = Flight.airStep(pos, v, s, dt, params)
            if np.Y < gy and nv.Y < 0 then
                np = Vector3.new(np.X, gy, np.Z)
                local bv, bs = Flight.bounce(nv, ns, params)
                if bv.Y < Flight.BOUNCE_MIN then
                    bv, bs = Flight.toGround(bv, bs)
                    rolling = true
                end
                nv, ns = bv, bs
            end
        end
        pos, v, s = np, nv, ns
        t += dt
        n += 1
        list[n] = { t = t, pos = pos }
    end
    return list
end


function MystrixHub.Functions.CreateFPSTag()
    MystrixHub.Functions.DestroyFPSTag()
    local tag = MystrixHub.UIController.Window:Tag({ Title = "FPS: --", Color = MystrixHub.UIController.CurrentAccent })
    MystrixHub.UIController.FPSTag = tag
    local acc, frames = 0, 0
    MystrixHub.UIController.FPSConnection = RunService.Heartbeat:Connect(function(dt)
        acc += dt
        frames += 1
        if acc < 1 then return end
        tag:SetTitle("FPS: " .. math.floor(frames / acc))
        acc, frames = 0, 0
    end)
end

function MystrixHub.Functions.DestroyPingTag()
    if MystrixHub.UIController.PingTag then
        pcall(function() MystrixHub.UIController.PingTag:Destroy() end)
        MystrixHub.UIController.PingTag = nil
    end
    if MystrixHub.UIController.PingConnection then
        MystrixHub.UIController.PingConnection:Disconnect()
        MystrixHub.UIController.PingConnection = nil
    end
end

function MystrixHub.Functions.CreatePingTag()
    MystrixHub.Functions.DestroyPingTag()
    MystrixHub.UIController.PingTag = MystrixHub.UIController.Window:Tag({ Title = "Ping: --", Color = MystrixHub.UIController.CurrentAccent })
    local item
    pcall(function()
        item = Services.Stats.Network.ServerStatsItem["Data Ping"]
    end)
    local acc = 1
    MystrixHub.UIController.PingConnection = RunService.Heartbeat:Connect(function(dt)
        acc += dt
        if acc < 1 then return end
        acc = 0
        if not item then return end
        local ok, ping = pcall(function() return math.floor(item:GetValue()) end)
        if ok and ping and MystrixHub.UIController.PingTag then
            MystrixHub.UIController.PingTag:SetTitle("Ping: " .. ping .. "ms")
        end
    end)
end


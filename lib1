	params.Font = fontOf(nil)
	params.Size = size
	params.Width = width
	local ok, bounds = pcall(TextService.GetTextBoundsAsync, TextService, params)
	if not ok then return math.ceil(size * 1.4) end
	return math.ceil(bounds.Y)
end


function Window:OpenSectionInfo(section, anchor)
	if self.LastPopupAnchor == anchor and os.clock() - self.LastPopupTime < 0.2 then return end
	if not self.Info then self:_buildInfoPopup() end
	local info, pad = self.Info, Metrics.Pad
	for _, row in info.Rows do row:Destroy() end
	info.Rows = {}
	setText(info.Title, section.Name)
	local textW = info.Width - pad * 2 - 6
	local y = 6
	for _, item in section.Items do
		if item.Description then
			local name = label(info.List, {
				Text = item.Name or item.Kind, TextSize = 12, X = pad, Y = y, Right = pad,
				Weight = Enum.FontWeight.SemiBold, Truncate = Enum.TextTruncate.AtEnd,
			})
			local height = measureWrapped(item.Description, 11, textW)
			local text = new("TextLabel", {
				Fg = "InactiveText", Text = item.Description, TextSize = 11, TextWrapped = true,
				Position = Offset(pad, y + 19), Size = Offset(textW, height),
			}, info.List)
			table.insert(info.Rows, name)
			table.insert(info.Rows, text)
			y += 19 + height + 10
		end
	end
	local listH = math.min(y, 220)
	info.List.CanvasSize = Offset(0, y)
	info.List.CanvasPosition = Vec2(0, 0)
	info.Frame.Size = Offset(info.Width, 32 + listH + 6)
	local p, s = anchor.AbsolutePosition, anchor.AbsoluteSize
	self:_openPopup(info, anchor, Vec2(p.X + s.X - info.Width * LayerScale, p.Y + s.Y + Metrics.Gap))

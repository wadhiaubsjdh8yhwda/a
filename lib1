function Window:BuildHome(tab, options)
	options = options or {}
	local player = Players.LocalPlayer
	local TeleportService = game:GetService("TeleportService")
	local busy = false

	table.insert(self.Connections, TeleportService.TeleportInitFailed:Connect(function(_, _, message)
		busy = false
		self:Notify(message ~= "" and message or "Teleport failed.", "Error")
	end))

	local function go(action, message)
		if busy then
			self:Notify("A teleport is already in progress.", "Warning")
			return
		end
		busy = true
		self:Notify(message, "Info")
		task.spawn(function()
			local ok, result, reason = pcall(action)
			if not ok or result == false then
				busy = false
				self:Notify(ok and reason or "Teleport failed.", ok and "Warning" or "Error")
			end
		end)
		task.delay(10, function() busy = false end)
	end

	local function hop()
		local ok, data = pcall(function()
			return HttpService:JSONDecode(game:HttpGet(
				("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
			))
		end)
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
			return false, "Could not fetch the server list."
		end
		local pool = {}
		for _, server in data.data do
			if server.id ~= game.JobId and server.playing < server.maxPlayers - 1 then
				table.insert(pool, server.id)
			end
		end
		if #pool == 0 then return false, "No open servers found." end
		TeleportService:TeleportToPlaceInstance(game.PlaceId, pool[math.random(#pool)], player)
	end

	local function rejoin()
		if #Players:GetPlayers() <= 1 then
			player:Kick("\nRejoining...")
			task.wait()
			TeleportService:Teleport(game.PlaceId, player)
		else
			TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
		end
	end

	local profile = tab:Section({ Name = "Player Info", Icon = "user", Side = 1 })
	profile:Profile({ UserId = player.UserId, DisplayName = player.DisplayName, Username = player.Name })

	local changelog = tab:Section({ Name = "Changelog", Icon = "scroll-text", Side = 1 })
	changelog:Changelog({ Entries = options.Changelog or {
		{
			Version = "v1.1.0", Date = "Nov 27, 2026",
			Changes = {
				{ "Added", "Home tab with player info, game details and server tools." },
				{ "Added", "Join any server by pasting its Job ID." },
				{ "Improved", "Config list now refreshes after every save." },
				{ "Fixed", "Dropdown panels no longer overlap the window edge." },
			},
		},
		{
			Version = "v1.0.0", Date = "Nov 12, 2026",
			Changes = {
				{ "Added", "Initial release with theming, configs and hotkeys." },
				{ "Removed", "Legacy settings menu." },
			},
		},
	} })

	local gameSection = tab:Section({ Name = "Game Details", Icon = "gamepad-2", Side = 2 })
	gameSection:GameCard({ PlaceId = game.PlaceId, GameId = game.GameId })
	gameSection:Divider()
	gameSection:Button({
		Name = "Server Hop", Description = "Teleports you to a random public server that has open slots.",
		Callback = function() go(hop, "Searching for a server...") end,
	})
	gameSection:Button({
		Name = "Rejoin", Description = "Rejoins the current server, or a fresh one if you are alone.",
		Callback = function() go(rejoin, "Rejoining...") end,
	})
	gameSection:Button({
		Name = "Copy Job ID", Description = "Copies this server's Job ID to your clipboard.",
		Callback = function()
			if copyToClipboard(game.JobId) then
				self:Notify("Job ID copied to clipboard.")
			else
				self:Notify("Clipboard unavailable on this executor.", "Warning")
			end
		end,
	})
	gameSection:Divider()
	local jobBox = gameSection:Textbox({ Placeholder = "Paste a Job ID", NoSave = true })
	gameSection:Button({
		Name = "Join Job ID", Description = "Joins the server matching the Job ID typed above.",
		Callback = function()
			local id = string.gsub(jobBox.Instance.Text, "%s", "")
			if id == "" then
				self:Notify("Enter a Job ID first.", "Warning")
			elseif id == game.JobId then
				self:Notify("You are already in this server.", "Warning")
			else
				go(function()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, id, player)
				end, "Joining server...")
			end
		end,
	})
end

